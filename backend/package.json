{
  "name": "solace-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API for Solace AI, a wellness companion app",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/index.js",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "db:up": "podman start solace-db 2>/dev/null || podman run -d --name solace-db --restart unless-stopped -e POSTGRES_USER=solace -e POSTGRES_PASSWORD=solace -e POSTGRES_DB=solace -p 127.0.0.1:5433:5432 -v solace-db-data:/var/lib/postgresql/data docker.io/library/postgres:16-alpine",
    "db:down": "podman stop solace-db",
    "seed:demo": "tsx --env-file-if-exists=.env src/seed-demo.ts",
    "test": "node --env-file-if-exists=.env --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "groq-sdk": "^1.6.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
