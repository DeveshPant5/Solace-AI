# Copy to .env and fill in.
PORT=4000
DATABASE_URL=postgres://solace:solace@localhost:5433/solace

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

# Anthropic API key from https://platform.claude.com/ (Settings -> API keys).
# Without it the app still works, but Sol (the AI companion) and the
# AI-written suggestions fall back to offline content.
ANTHROPIC_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CHAT_EFFORT=low

# Optional: ElevenLabs API key from https://elevenlabs.io/ (Developers -> API keys)
# gives Pip, the onboarding guide, a natural voice via GET /voice/speak.
# Without it that endpoint answers 503 voice_off.
ELEVENLABS_API_KEY=
# PIP_VOICE_ID=bIHbv24MWmeRgasZH58o
# ELEVENLABS_MODEL=eleven_flash_v2_5
