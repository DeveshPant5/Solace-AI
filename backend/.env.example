# Copy to .env (keep it private: `umask 077; cp .env.example .env`) and fill in.
# The server checks these at startup and refuses to start with a clear message
# if something is missing or invalid.
PORT=4000
DATABASE_URL=postgres://solace:solace@localhost:5433/solace

# Required. Long random string used to sign login tokens (at least 32 characters).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ---------- AI (Sol and the AI suggestions) ----------
# Groq runs open models and has a free tier: create a key at
# https://console.groq.com/keys . Without any AI key the app still works, but
# Sol is off and the suggestions use offline content.
GROQ_API_KEY=
# GROQ_CHAT_MODEL=openai/gpt-oss-120b   # Sol's chat (needs tool use)
# GROQ_FAST_MODEL=openai/gpt-oss-20b    # short JSON jobs; a separate free allowance
# Tried in order when a model is rate limited or retired (each model has its own free allowance):
# GROQ_CHAT_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b
# GROQ_FAST_FALLBACK_MODELS=qwen/qwen3.8-27b

# Optional: Claude instead (paid). Used when GROQ_API_KEY is empty, or with AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CHAT_EFFORT=low            # low | medium | high | xhigh | max

# AI_PROVIDER=auto           # auto (Groq if its key is set, else Claude) | groq | anthropic
# AI_DISABLED=1              # emergency switch: offline content only, keys stay in place

# Optional: ElevenLabs API key from https://elevenlabs.io/ (Developers -> API keys)
# gives Pip, the onboarding guide, a natural voice via GET /voice/speak.
# Without it that endpoint answers 503 voice_off and the app uses the phone's voice.
# Pip only uses the characters your plan already includes: the server checks the
# balance and stops before the limit, then the app uses the phone's voice until
# the monthly reset. On a free account (no card) it never costs anything.
ELEVENLABS_API_KEY=
# PIP_VOICE_ID=bIHbv24MWmeRgasZH58o
# ELEVENLABS_MODEL=eleven_flash_v2_5
# VOICE_DISABLED=1
# VOICE_CACHE_MAX_MB=200     # disk cache for Pip's clips; least recently played are removed past this

# ---------- Deployment ----------
# Number of reverse proxies in front of the API. 0 (default) for local and LAN
# use; 3 on Render (set in render.yaml). Rate limits rely on this being right:
# check GET /health/ip shows your own public IP.
# TRUST_PROXY=0
# Browser origins allowed to call the API (the phone app is never affected).
# Development allows any origin; production allows none unless listed here.
# CORS_ORIGINS=https://solace.example.com
# LOG_REQUESTS=1             # one line per request: method, path (no query), status, time

# ---------- Daily spending limits (per server process, reset at midnight UTC) ----------
# Past a limit the app uses its offline content (or the phone's voice) until the
# next day. Groq's free tier has its own per-model daily limits on top of these;
# for paid services also set a monthly spend limit in their dashboards.
# AI_DAILY_REQUESTS=2000         # AI requests (Groq or Claude)
# AI_DAILY_OUTPUT_TOKENS=1500000
# AI_PUBLIC_DAILY_REQUESTS=300   # onboarding helper, used before sign-up
# AI_USER_DAILY_REQUESTS=250     # per account
# VOICE_DAILY_CHARS=20000

# ---------- Demo seed (npm run seed:demo) ----------
# Only needed to seed a database that isn't local:
# ALLOW_DEMO_SEED=1
# SEED_DEMO_PASSWORD=
