# Copy to .env (keep it private: `umask 077; cp .env.example .env`) and fill in.
# The server checks these at startup and refuses to start with a clear message
# if something is missing or invalid.
PORT=4000
DATABASE_URL=postgres://solace:solace@localhost:5433/solace

# Required. Long random string used to sign login tokens (at least 32 characters).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Anthropic API key from https://platform.claude.com/ (Settings -> API keys).
# Without it the app still works, but Sol (the AI companion) and the
# AI-written suggestions fall back to offline content.
ANTHROPIC_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CHAT_EFFORT=low            # low | medium | high | xhigh | max
# AI_DISABLED=1              # emergency switch: offline content only, key stays in place

# Optional: ElevenLabs API key from https://elevenlabs.io/ (Developers -> API keys)
# gives Pip, the onboarding guide, a natural voice via GET /voice/speak.
# Without it that endpoint answers 503 voice_off and the app uses the phone's voice.
ELEVENLABS_API_KEY=
# PIP_VOICE_ID=bIHbv24MWmeRgasZH58o
# ELEVENLABS_MODEL=eleven_flash_v2_5
# VOICE_DISABLED=1
# VOICE_CACHE_MAX_MB=200     # disk cache for Pip's clips; least recently played are removed past this

# ---------- Deployment ----------
# Number of reverse proxies in front of the API. 0 (default) for local and LAN
# use; 1 on Render, Railway or Fly. Rate limits rely on this being right.
# TRUST_PROXY=0
# Browser origins allowed to call the API (the phone app is never affected).
# Development allows any origin; production allows none unless listed here.
# CORS_ORIGINS=https://solace.example.com
# LOG_REQUESTS=1             # one line per request: method, path (no query), status, time

# ---------- Daily spending limits (per server process, reset at midnight UTC) ----------
# Past a limit the app uses its offline content (or the phone's voice) until the
# next day. Also set a monthly spend limit in the Anthropic and ElevenLabs dashboards.
# AI_DAILY_REQUESTS=2000
# AI_DAILY_OUTPUT_TOKENS=1500000
# AI_PUBLIC_DAILY_REQUESTS=300   # onboarding helper, used before sign-up
# AI_USER_DAILY_REQUESTS=250     # per account
# VOICE_DAILY_CHARS=20000

# ---------- Demo seed (npm run seed:demo) ----------
# Only needed to seed a database that isn't local:
# ALLOW_DEMO_SEED=1
# SEED_DEMO_PASSWORD=
