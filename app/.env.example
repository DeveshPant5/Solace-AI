# Optional: where the app finds the Solace API.
# In development it defaults to the Expo dev server's machine on port 4000.
# For an APK, scripts/build-apk.sh sets this from API_URL.
EXPO_PUBLIC_API_URL=

# Sign in with Google. Usually leave this empty: the app reads the Web client id
# from the API (GET /auth/providers, from the backend's GOOGLE_CLIENT_IDS), so it
# can be turned on without a rebuild. Set it only to build the id into the app.
# See README.md → "Sign in with Google and Apple".
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Only for iOS builds: the iOS client id (also adds the URL scheme Google needs).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
